# HIT 서버 설정. 이 파일을 .env 로 복사해 값을 채우세요.
PORT=8787
HIT_DB=data/hit.db
# naver: 실제 KBO 경기 / replay: 2026 PO 2차전을 실시간처럼 재생 (비시즌 테스트용)
HIT_PROVIDER=naver
POLL_MS=10000
PREGAME_MINUTES=30

# Apple Developer → Certificates, Identifiers & Profiles → Keys 에서 만든 APNs 키(.p8)
# 비워 두면 실제로 보내지 않고 로그만 남깁니다(dry-run).
APNS_KEY_FILE=./AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_BUNDLE_ID=com.yourname.hit

# 로그인
# Apple: 비워 두면 APNS_BUNDLE_ID 를 씁니다 (앱 번들 ID)
APPLE_CLIENT_ID=
# 카카오: developers.kakao.com → 내 애플리케이션 → 앱 키(REST API 키), 카카오 로그인 활성화,
#        Redirect URI 에 {PUBLIC_BASE_URL}/v1/auth/kakao/callback 등록
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
PUBLIC_BASE_URL=https://hit.example.com

# 구장 날씨 (Open-Meteo). 비우면 무료(비상업용) 주소, 상업용 키가 있으면 넣는다. off 로 끈다
HIT_WEATHER=
HIT_WEATHER_KEY=
# 내 팀 소식: 네이버 검색 API (developers.naver.com → 애플리케이션 등록 → 검색). 비우면 뉴스 기능이 꺼진다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
